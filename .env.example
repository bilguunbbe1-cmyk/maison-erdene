# Copy to .env and fill in from Supabase: Project Settings > API.
# Only VITE_ variables reach the browser. The anon key is meant to be public, since RLS protects the data.
# NEVER put the service_role key or the Stripe secret key in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
